# HK Momentum + Policy 策略 .env 示例 - 复制到 .env 并填入真实值

# ---- Futu OpenD ----
FUTU_HOST=127.0.0.1
FUTU_PORT=11111
FUTU_TRD_ENV=SIMULATE      # 改为 REAL 才会走实盘. 强烈建议先 SIMULATE 跑 2-4 周
FUTU_TRD_MARKET=HK

# 富途账号交易解锁密码的 MD5 (32 位小写). 可以用以下命令生成:
#   echo -n '你的解锁密码' | md5
FUTU_UNLOCK_PWD_MD5=

# ---- 策略参数 ----
PAPER_EQUITY_HKD=1000000   # dry-run 假设的总权益, 用于计算建议仓位
HK_STRATEGY_PROFILE=conservative  # conservative | aggressive

# ---- 数据源 ----
AKSHARE_NEWS_CACHE=data/hk_news_live.json
HK_SNAPSHOT_CACHE=data/hk_snapshot.json
HK_UNIVERSE=data/hk_universe_kline.json

# ---- Tushare (可选, 升级积分后再启用) ----
# TUSHARE_TOKEN=
