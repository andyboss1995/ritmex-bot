
# Hedging Strategy Configuration
# Supports dual-account hedging for GRVT/StandX/etc.

# --- Account 1 (Primary) ---
# Supports standard variable names
# GRVT Specifics
GRVT_API_KEY=your_acc1_api_key
GRVT_API_SECRET=your_acc1_api_secret
GRVT_SUBACCOUNT_ID=your_acc1_subaccount_id

# --- Account 2 (Secondary) ---
# Uses "ACC2_" prefix
ACC2_GRVT_API_KEY=your_acc2_api_key
ACC2_GRVT_API_SECRET=your_acc2_api_secret
ACC2_GRVT_SUBACCOUNT_ID=your_acc2_subaccount_id

# --- Strategy Settings ---
# Symbol A: Account 1 Longs this, Account 2 Shorts this
HEDGE_SYMBOL_A=BTC-USD
# Symbol B: Account 1 Shorts this, Account 2 Longs this
HEDGE_SYMBOL_B=ETH-USD

# Trade Sizes
HEDGE_AMOUNT_A=0.001  # Amount for Symbol A
HEDGE_AMOUNT_B=0.01   # Amount for Symbol B

# Timing (Irregular Closing)
# Interval in milliseconds (e.g., 3600000 = 1 hour)
HEDGE_INTERVAL_MS=3600000
# Random jitter to add/subtract (e.g., 300000 = +/- 5 mins)
HEDGE_INTERVAL_JITTER_MS=300000

# Risk Management
HEDGE_MAX_CLOSE_SLIPPAGE_PCT=0.05
